{
  "name": "receipts",
  "version": "0.1.0",
  "description": "Live provenance for Bee facts: a verbatim receipt for every fact, doubtful ones sent to the wrist as a to-do, tick to forget.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "receipts": "./src/cli.ts"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "mutation": "bash scripts/mutation-check.sh",
    "live-check": "bash scripts/live-check.sh",
    "doctor": "node --disable-warning=ExperimentalWarning src/cli.ts doctor",
    "once": "node --disable-warning=ExperimentalWarning src/cli.ts once",
    "watch": "node --disable-warning=ExperimentalWarning src/cli.ts watch --serve",
    "review": "node --disable-warning=ExperimentalWarning src/cli.ts review",
    "report": "node --disable-warning=ExperimentalWarning src/cli.ts report",
    "why": "node --disable-warning=ExperimentalWarning src/cli.ts why",
    "viewport-check": "node --disable-warning=ExperimentalWarning scripts/viewport-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1154.0",
    "@beeai/cli": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
